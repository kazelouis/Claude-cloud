# Copy to .env and fill in. See README for details.

# ---- Database (PostgreSQL) ----
# Get a free database at https://neon.tech and paste its connection string.
# Looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me"
# In production set the public URL of the app, e.g. https://carpool.bgc.com
# AUTH_URL="https://your-domain"

# Restrict sign-ins to your organisation's email domain.
ALLOWED_EMAIL_DOMAIN="bgcengineering.ca"

# Admins (comma-separated emails) may delete anyone's post. Leave blank for none.
ADMIN_EMAILS=""

# Password-less dev login (email only). MUST be "false"/unset in production.
ENABLE_DEV_LOGIN="true"

# ---- Microsoft Entra ID (Azure AD) SSO — production sign-in ----
# Register an app at https://entra.microsoft.com, then fill these in.
# Leave blank to hide the Microsoft button (e.g. local dev).
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Your tenant ID (or "common"). Set your tenant to restrict to BGC only.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
