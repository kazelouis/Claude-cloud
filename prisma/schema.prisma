// BGC Carpool — data model
// PostgreSQL for both local dev and production. Point DATABASE_URL at your
// database (e.g. a free Neon database). See docs/DEPLOY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Auth.js (NextAuth) models -----

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  homeOffice    String? // default office for the board + new posts
  homeArea      String? // default pickup area for new posts
  accounts      Account[]
  sessions      Session[]
  rides         Ride[]
  responses     Response[]
  createdAt     DateTime   @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- Carpool domain models -----

// A single Ride post covers both an OFFER (driver has seats) and a
// REQUEST (rider needs a seat). `type` distinguishes them.
model Ride {
  id            String     @id @default(cuid())
  type          String // "OFFER" | "REQUEST"
  direction     String // "TO_WORK" | "FROM_WORK" | "ROUND_TRIP"
  office        String? // BGC office this ride serves, e.g. "Vancouver, BC"
  area          String // pickup / neighbourhood area
  date          DateTime? // specific day, null when recurring
  recurring     Boolean    @default(false)
  daysOfWeek    String? // CSV for recurring, e.g. "MON,TUE,WED"
  arrivalTime   String? // "08:30" — when they need to arrive at the office
  departureTime String? // "17:00" — when they leave the office
  seats         Int        @default(1) // seats offered (OFFER) or needed (REQUEST)
  costShare     String? // notes on parking / gas sharing
  notes         String?
  status        String     @default("OPEN") // "OPEN" | "FULFILLED" | "CANCELLED"
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses     Response[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([type, status])
  @@index([direction])
  @@index([office])
}

// An expression of interest in a Ride from another employee.
model Response {
  id        String   @id @default(cuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  createdAt DateTime @default(now())

  @@unique([rideId, userId])
}
